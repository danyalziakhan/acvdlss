// sRGB value to log2 exposure.
float tone_to_log(float y, uint c)
{
    float t = saturate(y) * 64.0;
    uint i = min(uint(t), 63u);
    return lerp(TONE[c][i], TONE[c][i + 1], t - float(i));
}

// Inverse of tone_to_log. Binary search; below the table it extends the
// first step down to black.
float tone_from_log(float x, uint c)
{
    if (x >= TONE[c][64])
        return 1.0;
    if (x <= TONE[c][0])
        return max((x - TONE[c][0]) / (TONE[c][1] - TONE[c][0]) / 64.0, 0.0);
    uint lo = 0, hi = 64;
    [unroll] for (int k = 0; k < 6; ++k)
    {
        uint mid = (lo + hi) / 2;
        if (TONE[c][mid] <= x)
            lo = mid;
        else
            hi = mid;
    }
    return (float(lo) + (x - TONE[c][lo]) / (TONE[c][lo + 1] - TONE[c][lo])) / 64.0;
}

// GAIN at the pixel's color, trilinear.
float gain(float3 y, uint c)
{
    float3 t = saturate(y) * 5.0;
    uint3 i = min(uint3(t), 4u);
    float3 f = t - float3(i);
    uint b = i.x * 36 + i.y * 6 + i.z;
    float g00 = lerp(GAIN[c][b], GAIN[c][b + 1], f.z);
    float g01 = lerp(GAIN[c][b + 6], GAIN[c][b + 6 + 1], f.z);
    float g10 = lerp(GAIN[c][b + 36], GAIN[c][b + 36 + 1], f.z);
    float g11 = lerp(GAIN[c][b + 42], GAIN[c][b + 42 + 1], f.z);
    return lerp(lerp(g00, g01, f.y), lerp(g10, g11, f.y), f.x);
}

float4 vignette(float4 c, float2 uv, float strength, bool hdr)
{
    float2 q = uv - 0.5;
    float v = pow(max(1.0 - dot(q, q), 0.0), strength);
    if (hdr)
    {
        // HDR output is linear, so a plain multiply matches the game.
        c.rgb *= v;
        return c;
    }
    float shift = log2(max(v, 1e-6));
    float3 y = c.rgb;
    [unroll] for (uint i = 0; i < 3; ++i)
        c[i] = tone_from_log(tone_to_log(y[i], i) + gain(y, i) * shift, i);
    return c;
}
